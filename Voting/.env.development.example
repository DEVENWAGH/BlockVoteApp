# ═══════════════════════════════════════════════════════════════════════════
# BlockVote — DEVELOPMENT profile (Hardhat local)
# Copy to .env.development, then: yarn env:dev
# NEVER put Sepolia keys or production Mongo URI here.
# ═══════════════════════════════════════════════════════════════════════════

APP_ENV=development

# ── Database (separate from production) ─────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/blockvote_local

# ── Auth (dev-only secrets OK) ──────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-me
SERVER_IDENTITY_SECRET=dev-identity-secret-change-me
AUTH_SECRET=dev-auth-secret-change-me
NEXTAUTH_SECRET=dev-nextauth-secret-change-me
SERVER_ENCRYPTION_KEY=dev-encryption-key-32chars-min!!

# ── Public / app base URL ───────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ── Blockchain (Hardhat node — filled by yarn deploy:proxy / yarn dev) ──────
RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=
NEXT_PUBLIC_CONTRACT_ADDRESS=
CONTRACT_IMPL_ADDRESS=
ADMIN_RELAY_PRIVATE_KEY=
ADMIN_RELAY_ADDRESS=
DEPLOYER_PRIVATE_KEY=
GUARDIAN_1_PRIVATE_KEY=
GUARDIAN_2_PRIVATE_KEY=
GUARDIAN_3_PRIVATE_KEY=
GUARDIAN_1_ADDRESS=
GUARDIAN_2_ADDRESS=
GUARDIAN_3_ADDRESS=
NEXT_PUBLIC_GUARDIAN_1=
NEXT_PUBLIC_GUARDIAN_2=
NEXT_PUBLIC_GUARDIAN_3=
NEXT_PUBLIC_DEPLOYER_ADDRESS=

# ── Optional shared services (safe to reuse AWS/Resend in local) ────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=blockvotingdev

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@localhost

PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

DEV_SKIP_EMAIL=true
