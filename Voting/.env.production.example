# ═══════════════════════════════════════════════════════════════════════════
# BlockVote — PRODUCTION ARCHIVE (optional on this machine)
#
# Runtime production secrets for https://www.devz.co.in live on VERCEL.
# Do NOT copy this file over .env for next dev.
#
# Local use of this file:
#   - Optional backup of Sepolia RPC + deployer/relay/guardian keys
#   - Read only by: yarn deploy:sepolia / yarn deploy:v2-sepolia
#   - After deploy, copy new NEXT_PUBLIC_CONTRACT_ADDRESS into Vercel
# ═══════════════════════════════════════════════════════════════════════════

APP_ENV=production

# Not used by local Next — Vercel holds the real production Mongo URI
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/BlockVote?retryWrites=true&w=majority

NEXTAUTH_URL=https://www.devz.co.in
NEXT_PUBLIC_APP_URL=https://www.devz.co.in
APP_URL=https://www.devz.co.in

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

NEXT_PUBLIC_CONTRACT_ADDRESS=
CONTRACT_IMPL_ADDRESS=

DEPLOYER_PRIVATE_KEY=
ADMIN_RELAY_PRIVATE_KEY=
ADMIN_RELAY_ADDRESS=
GUARDIAN_1_PRIVATE_KEY=
GUARDIAN_2_PRIVATE_KEY=
GUARDIAN_3_PRIVATE_KEY=
GUARDIAN_1_ADDRESS=
GUARDIAN_2_ADDRESS=
GUARDIAN_3_ADDRESS=
NEXT_PUBLIC_GUARDIAN_1=
NEXT_PUBLIC_GUARDIAN_2=
NEXT_PUBLIC_GUARDIAN_3=
NEXT_PUBLIC_DEPLOYER_ADDRESS=
